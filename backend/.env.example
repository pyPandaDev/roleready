# Firebase Service Account Path
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Server
PORT=8000
DEBUG=False

# IMPORTANT: For production, set this to your deployed frontend URL
# Example: https://roleready.vercel.app or https://yourdomain.com
FRONTEND_URL=http://localhost:5173

# Admin Panel Credentials (REQUIRED for admin access)
# Use a strong password for production (min 16 chars with symbols)
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=your_secure_password_here

# JWT Secret Key - CRITICAL for security!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be at least 64 characters for production
JWT_SECRET=generate_a_random_64_char_secret_here_using_the_command_above

# Optional: Google Search API (for enhanced features)
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_google_search_engine_id_here