# ============================================
# RoleReady - Global Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# 
# IMPORTANT: Never commit .env file to version control!
# ============================================

# ==========================================
# FRONTEND CONFIGURATION (Vite)
# ==========================================
# Get these from Firebase Console > Project Settings > General
# These are exposed to the client (safe to expose)

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Backend API URL
# Development: http://localhost:8000
# Production: https://your-backend-url.onrender.com
VITE_API_URL=http://localhost:8000

# ==========================================
# BACKEND CONFIGURATION (FastAPI)
# ==========================================

# Firebase Service Account
# Download from Firebase Console > Project Settings > Service Accounts
FIREBASE_SERVICE_ACCOUNT_PATH=./backend/firebase-service-account.json

# Google Gemini AI API Key
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=8000
DEBUG=False

# Frontend URL for CORS
# Development: http://localhost:3000
# Production: https://your-frontend-url.vercel.app
FRONTEND_URL=http://localhost:3000

# ==========================================
# ADMIN PANEL (Required for Admin Access)
# ==========================================

# Admin login credentials
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=YourSecurePassword123!

# JWT Secret for admin sessions
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# MUST be at least 64 characters for production security
JWT_SECRET=your_64_character_secret_key_generated_using_the_command_above

# ==========================================
# OPTIONAL FEATURES
# ==========================================

# Google Search API (for enhanced search features)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_google_search_engine_id_here
